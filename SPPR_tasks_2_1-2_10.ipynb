    "# Системы поддержки принятия решений\n",
    "\n",
    "**Тема: «Упражнения 2.1–2.10»**\n",
    "\n",
     Для задачи 2.2 использовано дополнение к исходным данным: 5 досковых футов на стул и 15 — на стол. В задаче 2.8 исходные величины заданы символически, поэтому решение представлено параметрическими моделями."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "ccccdd41",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Решатель: appsi_highs. Среда готова к выполнению задач.\n"
     ]
    }
   ],
   "source": [
    "import pyomo.environ as pyo\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "from IPython.display import display\n",
    "\n",
    "pd.set_option(\"display.float_format\", \"{:,.4f}\".format)\n",
    "pd.set_option(\"display.max_columns\", 10)\n",
    "\n",
    "plt.rcParams.update({\n",
    "    \"figure.figsize\": (8.5, 5.2),\n",
    "    \"figure.dpi\": 120,\n",
    "    \"font.family\": \"DejaVu Sans\",\n",
    "    \"font.size\": 11,\n",
    "    \"axes.titlesize\": 13,\n",
    "    \"axes.labelsize\": 11,\n",
    "    \"axes.spines.top\": False,\n",
    "    \"axes.spines.right\": False,\n",
    "    \"axes.grid\": True,\n",
    "    \"grid.alpha\": 0.22,\n",
    "    \"lines.linewidth\": 2,\n",
    "    \"savefig.bbox\": \"tight\",\n",
    "})\n",
    "\n",
    "solver = None\n",
    "for solver_name in (\"appsi_highs\", \"highs\", \"cbc\"):\n",
    "    candidate = pyo.SolverFactory(solver_name)\n",
    "    if candidate.available(exception_flag=False):\n",
    "        solver = candidate\n",
    "        break\n",
    "\n",
    "if solver is None:\n",
    "    raise RuntimeError(\n",
    "        \"Решатель не найден. Установите highspy: python -m pip install highspy\"\n",
    "    )\n",
    "\n",
    "def solve_model(model):\n",
    "    result = solver.solve(model, tee=False)\n",
    "    pyo.assert_optimal_termination(result)\n",
    "    return result\n",
    "\n",
    "print(f\"Решатель: {solver_name}. Среда готова к выполнению задач.\")"
   ]
  },
