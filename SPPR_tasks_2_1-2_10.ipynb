    "machine_counts = {1: 5, 2: 2, 3: 4}\n",
    "processing_times = np.array([[2, 3, 4], [3, 5, 6], [4, 7, 9]])\n",
    "product_profit = {1: 6, 2: 8, 3: 10}\n",
    "\n",
    "model_24 = pyo.ConcreteModel()\n",
    "model_24.machines = pyo.RangeSet(1, 3)\n",
    "model_24.products = pyo.RangeSet(1, 3)\n",
    "model_24.production = pyo.Var(model_24.products, domain=pyo.NonNegativeReals)\n",
    "model_24.workers = pyo.Var(\n",
    "    model_24.machines,\n",
    "    domain=pyo.NonNegativeReals,\n",
    "    bounds=lambda model, machine: (0, machine_counts[machine]),\n",
    ")\n",
    "model_24.processing = pyo.Expression(\n",
    "    model_24.machines,\n",
    "    rule=lambda model, machine: sum(processing_times[machine - 1, product - 1]\n",
    "                                    * model.production[product] for product in model.products),\n",
    ")\n",
    "model_24.labor_limit = pyo.Constraint(\n",
    "    model_24.machines,\n",
    "    rule=lambda model, machine: model.processing[machine] <= 35 * model.workers[machine],\n",
    ")\n",
    "model_24.machine_limit = pyo.Constraint(\n",
    "    model_24.machines,\n",
    "    rule=lambda model, machine: model.processing[machine] <= 40 * machine_counts[machine],\n",
    ")\n",
    "model_24.all_workers = pyo.Constraint(expr=sum(model_24.workers[i] for i in model_24.machines) == 10)\n",
    "model_24.profit = pyo.Objective(\n",
    "    expr=sum(product_profit[j] * model_24.production[j] for j in model_24.products),\n",
    "    sense=pyo.maximize,\n",
    ")\n",
    "solve_model(model_24)\n",
    "\n",
    "integer_workers_24 = model_24.clone()\n",
    "for machine in integer_workers_24.machines:\n",
    "    integer_workers_24.workers[machine].domain = pyo.NonNegativeIntegers\n",
    "solve_model(integer_workers_24)\n",
    "\n",
    "display(pd.DataFrame({\n",
    "    \"Продукт\": [1, 2, 3],\n",
    "    \"Выпуск в ЛП, ед.\": [pyo.value(model_24.production[j]) for j in model_24.products],\n",
    "    \"Выпуск при целых назначениях, ед.\": [\n",
    "        pyo.value(integer_workers_24.production[j]) for j in integer_workers_24.products\n",
    "    ],\n",
    "}))\n",
    "display(pd.DataFrame({\n",
    "    \"Тип машин\": [1, 2, 3],\n",
    "    \"Рабочие в ЛП\": [pyo.value(model_24.workers[i]) for i in model_24.machines],\n",
    "    \"Целое назначение рабочих\": [pyo.value(integer_workers_24.workers[i])\n",
    "                                  for i in integer_workers_24.machines],\n",
    "    \"Обработка, ч\": [pyo.value(integer_workers_24.processing[i])\n",
    "                    for i in integer_workers_24.machines],\n",
    "    \"Фонд назначенных рабочих, ч\": [35 * pyo.value(integer_workers_24.workers[i])\n",
    "                                     for i in integer_workers_24.machines],\n",
    "}))\n",
    "print(f\"Прибыль ЛП: {pyo.value(model_24.profit):.2f} долл./нед.\")\n",
    "print(f\"Прибыль при целых назначениях: {pyo.value(integer_workers_24.profit):.2f} долл./нед.\")\n",
    "print(f\"Разрыв: {pyo.value(model_24.profit) - pyo.value(integer_workers_24.profit):.2e}\")"
