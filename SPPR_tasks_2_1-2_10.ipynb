    "portfolio_budget = 1_000_000\n",
    "expected_return = {\"A\": 0.12, \"B\": 0.08, \"C\": 0.05}\n",
    "asset_risk = {\"A\": 0.18, \"B\": 0.15, \"C\": 0.06}\n",
    "\n",
    "model_25 = pyo.ConcreteModel()\n",
    "model_25.assets = pyo.Set(initialize=[\"A\", \"B\", \"C\"], ordered=True)\n",
    "model_25.investment = pyo.Var(model_25.assets, domain=pyo.NonNegativeReals)\n",
    "model_25.budget = pyo.Constraint(\n",
    "    expr=sum(model_25.investment[asset] for asset in model_25.assets) == portfolio_budget\n",
    ")\n",
    "model_25.risk = pyo.Constraint(\n",
    "    expr=sum(asset_risk[asset] * model_25.investment[asset] for asset in model_25.assets)\n",
    "    <= 0.12 * portfolio_budget\n",
    ")\n",
    "model_25.annual_income = pyo.Objective(\n",
    "    expr=sum(expected_return[asset] * model_25.investment[asset] for asset in model_25.assets),\n",
    "    sense=pyo.maximize,\n",
    ")\n",
    "solve_model(model_25)\n",
    "\n",
    "display(pd.DataFrame({\n",
    "    \"Актив\": list(model_25.assets),\n",
