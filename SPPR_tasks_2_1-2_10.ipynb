    "def build_delivery_model(normal_times, deadlines, early_penalties=None):\n",
    "    normal_times = np.asarray(normal_times, dtype=float)\n",
    "    deadlines = np.asarray(deadlines, dtype=float)\n",
    "    if normal_times.shape != (3,) or deadlines.shape != (3,):\n",
    "        raise ValueError(\"Требуются три обычных времени и три дедлайна.\")\n",
    "    if not np.isfinite(normal_times).all() or np.any(normal_times <= 0):\n",
    "        raise ValueError(\"Обычные времена должны быть положительными и конечными.\")\n",
    "    if not np.isfinite(deadlines).all():\n",
    "        raise ValueError(\"Дедлайны должны быть конечными.\")\n",
    "\n",
    "    model = pyo.ConcreteModel()\n",
    "    model.houses = pyo.RangeSet(1, 3)\n",
    "    model.time_factor = pyo.Var(model.houses, bounds=(0.5, None))\n",
    "    model.lateness = pyo.Var(model.houses, domain=pyo.NonNegativeReals)\n",
    "    model.arrival = pyo.Expression(\n",
    "        model.houses,\n",
    "        rule=lambda model, house: sum(\n",
    "            normal_times[segment - 1] * model.time_factor[segment]\n",
    "            for segment in range(1, house + 1)\n",
    "        ),\n",
    "    )\n",
    "    model.total_factor = pyo.Constraint(\n",
    "        expr=sum(model.time_factor[house] for house in model.houses) >= 2.5\n",
    "    )\n",
    "    model.late_bound = pyo.Constraint(\n",
    "        model.houses,\n",
    "        rule=lambda model, house: model.lateness[house]\n",
    "        >= model.arrival[house] - deadlines[house - 1],\n",
    "    )\n",
    "    penalty = sum(model.lateness[house] for house in model.houses)\n",
    "\n",
    "    if early_penalties is not None:\n",
    "        early_penalties = np.asarray(early_penalties, dtype=float)\n",
    "        if early_penalties.shape != (3,):\n",
    "            raise ValueError(\"Требуются три коэффициента штрафа за ранний приезд.\")\n",
    "        if not np.isfinite(early_penalties).all() or np.any(early_penalties < 0):\n",
    "            raise ValueError(\"Коэффициенты штрафа должны быть конечными и неотрицательными.\")\n",
    "        model.earliness = pyo.Var(model.houses, domain=pyo.NonNegativeReals)\n",
    "        model.early_bound = pyo.Constraint(\n",
    "            model.houses,\n",
    "            rule=lambda model, house: model.earliness[house]\n",
    "            >= deadlines[house - 1] - model.arrival[house],\n",
    "        )\n",
    "        penalty += sum(\n",
    "            early_penalties[house - 1] * model.earliness[house]\n",
    "            for house in model.houses\n",
    "        )\n",
    "\n",
    "    model.total_penalty = pyo.Objective(expr=penalty, sense=pyo.minimize)\n",
    "    return model\n",
    "\n",
    "\n",
    "arrival_formulas_28 = [\"a₁x₁\", \"a₁x₁ + a₂x₂\", \"a₁x₁ + a₂x₂ + a₃x₃\"]\n",
    "display(\n",
    "    pd.DataFrame(\n",
    "        {\n",
    "            \"Дом\": [1, 2, 3],\n",
    "            \"Время прибытия Aᵢ\": arrival_formulas_28,\n",
    "            \"Ограничение опоздания\": [\"ℓ₁ ≥ A₁ − d₁\", \"ℓ₂ ≥ A₂ − d₂\", \"ℓ₃ ≥ A₃ − d₃\"],\n",
    "            \"Дополнение в (b)\": [\"e₁ ≥ d₁ − A₁\", \"e₂ ≥ d₂ − A₂\", \"e₃ ≥ d₃ − A₃\"],\n",
    "        }\n",
    "    )\n",
    ")\n",
    "print(\"(a) Минимизируется сумма ℓᵢ; (b) — сумма ℓᵢ + ρᵢeᵢ.\")\n",
    "print(\"Численное решение не требуется: aᵢ, dᵢ и ρᵢ в условии не заданы.\")"
   ]
