    "model_27 = pyo.ConcreteModel()\n",
    "model_27.activities = pyo.RangeSet(1, 2)\n",
    "initial_days_27 = {1: 200, 2: 100}\n",
    "reduction_27 = {1: 3, 2: 2}\n",
    "model_27.spending = pyo.Var(\n",
    "    model_27.activities,\n",
    "    domain=pyo.NonNegativeReals,\n",
    "    bounds=lambda model, activity: (\n",
    "        0, initial_days_27[activity] / reduction_27[activity]\n",
    "    ),\n",
    ")\n",
    "model_27.completion_time = pyo.Var(domain=pyo.NonNegativeReals)\n",
    "model_27.budget = pyo.Constraint(\n",
    "    expr=sum(model_27.spending[activity] for activity in model_27.activities) <= 50\n",
    ")\n",
    "model_27.finish = pyo.Constraint(\n",
    "    model_27.activities,\n",
    "    rule=lambda model, activity: model.completion_time\n",
    "    >= initial_days_27[activity] - reduction_27[activity] * model.spending[activity],\n",
    ")\n",
    "model_27.duration = pyo.Objective(\n",
    "    expr=model_27.completion_time,\n",
    "    sense=pyo.minimize,\n",
    ")\n",
    "solve_model(model_27)\n",
    "\n",
    "allocation_27 = []\n",
    "for activity in model_27.activities:\n",
    "    spending = pyo.value(model_27.spending[activity])\n",
    "    allocation_27.append(\n",
    "        {\n",
    "            \"Деятельность\": activity,\n",
    "            \"Выделено, долл.\": 10000 * spending,\n",
    "            \"Доля бюджета, %\": 100 * spending / 50,\n",
    "            \"Сокращение, дней\": reduction_27[activity] * spending,\n",
    "            \"Длительность, дней\": initial_days_27[activity]\n",
    "            - reduction_27[activity] * spending,\n",
    "        }\n",
    "    )\n",
    "display(pd.DataFrame(allocation_27))\n",
    "print(f\"Минимальный срок завершения проекта: {pyo.value(model_27.duration):.0f} дней.\")"
   ]
  },
