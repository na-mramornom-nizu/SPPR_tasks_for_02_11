   "source": [
    "model_210 = pyo.ConcreteModel()\n",
    "model_210.y1 = pyo.Var(domain=pyo.NonNegativeReals)\n",
    "model_210.y2 = pyo.Var(domain=pyo.NonNegativeReals)\n",
    "model_210.scale = pyo.Var(domain=pyo.NonNegativeReals)\n",
    "model_210.first_bound = pyo.Constraint(\n",
    "    expr=2 * model_210.y1 + 3 * model_210.y2 <= 6 * model_210.scale\n",
    ")\n",
    "model_210.second_bound = pyo.Constraint(\n",
    "    expr=2 * model_210.y1 + model_210.y2 <= 3 * model_210.scale\n",
    ")\n",
    "model_210.normalization = pyo.Constraint(\n",
    "    expr=2 * model_210.y2 + 7 * model_210.scale == 1\n",
    ")\n",
    "model_210.linear_objective = pyo.Objective(\n",
    "    expr=5 * model_210.y1 + 6 * model_210.y2,\n",
    "    sense=pyo.maximize,\n",
    ")\n",
    "solve_model(model_210)\n",
    "\n",
    "scale_210 = pyo.value(model_210.scale)\n",
    "original_x1_210 = pyo.value(model_210.y1) / scale_210\n",
    "original_x2_210 = pyo.value(model_210.y2) / scale_210\n",
    "original_objective_210 = (\n",
    "    (5 * original_x1_210 + 6 * original_x2_210) / (2 * original_x2_210 + 7)\n",
    ")\n",
    "display(\n",
    "    pd.DataFrame(\n",
    "        {\n",
    "            \"Переменная\": [\"y₁\", \"y₂\", \"t\", \"x₁ = y₁/t\", \"x₂ = y₂/t\"],\n",
    "            \"Оптимальное значение\": [\n",
    "                pyo.value(model_210.y1),\n",
    "                pyo.value(model_210.y2),\n",
    "                scale_210,\n",
    "                original_x1_210,\n",
    "                original_x2_210,\n",
    "            ],\n",
    "        }\n",
    "    )\n",
    ")\n",
    "display(\n",
    "    pd.DataFrame(\n",
    "        {\n",
    "            \"Ограничение исходной задачи\": [\"2x₁ + 3x₂ ≤ 6\", \"2x₁ + x₂ ≤ 3\"],\n",
    "            \"Левая часть\": [\n",
    "                2 * original_x1_210 + 3 * original_x2_210,\n",
    "                2 * original_x1_210 + original_x2_210,\n",
    "            ],\n",
    "            \"Правая часть\": [6, 3],\n",
    "        }\n",
    "    )\n",
    ")\n",
    "print(f\"Значение цели ЛП: {pyo.value(model_210.linear_objective):.6f}\")\n",
    "print(f\"Значение исходной дробной цели: {original_objective_210:.6f}\")"
   ]
