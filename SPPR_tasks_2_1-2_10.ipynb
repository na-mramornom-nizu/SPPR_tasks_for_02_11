    "furniture_data = pd.DataFrame({\n",
    "    \"wood\": [15, 15, 5, 5],\n",
    "    \"labor\": [2, 5, 2, 4],\n",
    "    \"price\": [70, 140, 60, 110],\n",
    "}, index=[\"unfinished_table\", \"finished_table\", \"unfinished_chair\", \"finished_chair\"])\n",
    "furniture_labels = [\"Стол незавершённый\", \"Стол готовый\", \"Стул незавершённый\", \"Стул готовый\"]\n",
    "\n",
    "model_22 = pyo.ConcreteModel()\n",
    "model_22.products = pyo.Set(initialize=furniture_data.index.tolist(), ordered=True)\n",
    "model_22.quantity = pyo.Var(model_22.products, domain=pyo.NonNegativeReals)\n",
    "model_22.wood_limit = pyo.Constraint(\n",
    "    expr=sum(furniture_data.loc[item, \"wood\"] * model_22.quantity[item]\n",
    "             for item in model_22.products) <= 40000\n",
    ")\n",
    "model_22.labor_limit = pyo.Constraint(\n",
    "    expr=sum(furniture_data.loc[item, \"labor\"] * model_22.quantity[item]\n",
    "             for item in model_22.products) <= 6000\n",
    ")\n",
    "model_22.profit = pyo.Objective(\n",
    "    expr=sum((furniture_data.loc[item, \"price\"] - furniture_data.loc[item, \"wood\"])\n",
    "             * model_22.quantity[item] for item in model_22.products),\n",
    "    sense=pyo.maximize,\n",
    ")\n",
    "solve_model(model_22)\n",
    "\n",
    "display(pd.DataFrame({\n",
    "    \"Изделие\": furniture_labels,\n",
    "    \"Количество, шт.\": [pyo.value(model_22.quantity[item]) for item in model_22.products],\n",
    "}))\n",
    "print(f\"Прибыль: {pyo.value(model_22.profit):,.2f} долл.\")\n",
    "print(f\"Расход древесины: {pyo.value(model_22.wood_limit.body):,.2f} доск. футов\")\n",
    "print(f\"Использовано рабочего времени: {pyo.value(model_22.labor_limit.body):,.2f} ч\")"
   ]
