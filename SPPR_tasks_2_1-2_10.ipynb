   "source": [
    "model_21 = pyo.ConcreteModel()\n",
    "model_21.first_bundle = pyo.Var(domain=pyo.NonNegativeReals)\n",
    "model_21.second_bundle = pyo.Var(domain=pyo.NonNegativeReals)\n",
    "model_21.phone_limit = pyo.Constraint(\n",
    "    expr=model_21.first_bundle + model_21.second_bundle <= 8\n",
    ")\n",
    "model_21.headset_limit = pyo.Constraint(expr=model_21.second_bundle <= 4)\n",
    "model_21.card_limit = pyo.Constraint(\n",
    "    expr=2 * model_21.first_bundle + 3 * model_21.second_bundle <= 19\n",
    ")\n",
    "model_21.profit = pyo.Objective(\n",
    "    expr=7 * model_21.first_bundle + 9 * model_21.second_bundle,\n",
    "    sense=pyo.maximize,\n",
    ")\n",
    "solve_model(model_21)\n",
    "\n",
    "bundle_values = np.array([\n",
    "    pyo.value(model_21.first_bundle),\n",
    "    pyo.value(model_21.second_bundle),\n",
    "])\n",
    "profit_21 = pyo.value(model_21.profit)\n",
    "display(pd.DataFrame({\n",
    "    \"Комплект\": [\"Первый\", \"Второй\"],\n",
    "    \"Количество, шт.\": bundle_values,\n",
    "}))\n",
    "print(f\"Максимальная прибыль: {profit_21:.2f} долл.\")\n",
    "print(f\"Оптимум целочисленный: {np.allclose(bundle_values, np.round(bundle_values))}\")"
   ]
