   "source": [
    "dual_21 = pyo.ConcreteModel()\n",
    "dual_21.phone_price = pyo.Var(domain=pyo.NonNegativeReals)\n",
    "dual_21.headset_price = pyo.Var(domain=pyo.NonNegativeReals)\n",
    "dual_21.card_price = pyo.Var(domain=pyo.NonNegativeReals)\n",
    "dual_21.first_bundle_value = pyo.Constraint(\n",
    "    expr=dual_21.phone_price + 2 * dual_21.card_price >= 7\n",
    ")\n",
    "dual_21.second_bundle_value = pyo.Constraint(\n",
    "    expr=dual_21.phone_price + dual_21.headset_price + 3 * dual_21.card_price >= 9\n",
    ")\n",
    "dual_21.stock_value = pyo.Objective(\n",
    "    expr=8 * dual_21.phone_price + 4 * dual_21.headset_price + 19 * dual_21.card_price,\n",
    "    sense=pyo.minimize,\n",
    ")\n",
    "solve_model(dual_21)\n",
    "\n",
    "resource_prices = np.array([\n",
    "    pyo.value(dual_21.phone_price),\n",
    "    pyo.value(dual_21.headset_price),\n",
    "    pyo.value(dual_21.card_price),\n",
    "])\n",
    "resource_use = np.array([[1, 1], [0, 1], [2, 3]]) @ bundle_values\n",
    "display(pd.DataFrame({\n",
    "    \"Товар\": [\"Телефон\", \"Гарнитура\", \"Карта\"],\n",
    "    \"Запас, шт.\": [8, 4, 19],\n",
    "    \"Использовано, шт.\": resource_use,\n",
    "    \"Остаток, шт.\": np.array([8, 4, 19]) - resource_use,\n",
    "    \"Двойственная оценка, долл./шт.\": resource_prices,\n",
    "}))\n",
    "print(f\"Минимальная стоимость запаса: {pyo.value(dual_21.stock_value):.2f} долл.\")\n",
    "print(f\"Разрыв двойственности: {pyo.value(dual_21.stock_value) - profit_21:.2e}\")\n",
    "\n",
    "offers = np.array([65, 62, 60])\n",
    "display(pd.DataFrame({\n",
    "    \"Предложение, долл.\": offers,\n",
    "    \"Изменение прибыли, долл.\": offers - profit_21,\n",
    "    \"Оценка\": [\"Выгодно принять\", \"Равноценно\", \"Невыгодно принимать\"],\n",
    "}))"
