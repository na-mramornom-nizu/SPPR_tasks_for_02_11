    "farm_cost = {(1, \"corn\"): 100, (2, \"corn\"): 120, (1, \"wheat\"): 90, (2, \"wheat\"): 80}\n",
    "farm_yield = {(1, \"corn\"): 500, (2, \"corn\"): 650, (1, \"wheat\"): 400, (2, \"wheat\"): 350}\n",
    "crop_demand = {\"corn\": 7000, \"wheat\": 11000}\n",
    "\n",
    "model_23 = pyo.ConcreteModel()\n",
    "model_23.farms = pyo.Set(initialize=[1, 2])\n",
    "model_23.crops = pyo.Set(initialize=[\"corn\", \"wheat\"])\n",
    "model_23.area = pyo.Var(model_23.farms, model_23.crops, domain=pyo.NonNegativeReals)\n",
    "model_23.land_limit = pyo.Constraint(\n",
    "    model_23.farms,\n",
    "    rule=lambda model, farm: sum(model.area[farm, crop] for crop in model.crops) <= 100,\n",
    ")\n",
    "model_23.demand = pyo.Constraint(\n",
    "    model_23.crops,\n",
    "    rule=lambda model, crop: sum(farm_yield[farm, crop] * model.area[farm, crop]\n",
    "                                 for farm in model.farms) >= crop_demand[crop],\n",
    ")\n",
    "model_23.cost = pyo.Objective(\n",
    "    expr=sum(farm_cost[farm, crop] * model_23.area[farm, crop]\n",
    "             for farm in model_23.farms for crop in model_23.crops),\n",
    "    sense=pyo.minimize,\n",
    ")\n",
    "solve_model(model_23)\n",
